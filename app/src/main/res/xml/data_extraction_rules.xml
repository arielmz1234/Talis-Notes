<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup (Android 12 and newer) and phone-to-phone transfer: notebooks, pictures and
     settings. Previews are rebuilt, and the Drive backup's sign-in state stays on each device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="notes.db" />
        <include domain="database" path="notes.db-wal" />
        <include domain="file" path="images/" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="notes.db" />
        <include domain="database" path="notes.db-wal" />
        <include domain="file" path="images/" />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
