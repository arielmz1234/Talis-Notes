<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup (Android 12 and newer) and tablet-to-tablet transfer: notebooks and
     settings. Cloud backup leaves pictures out to stay under the 25 MB limit (the backup file has them);
     a direct tablet-to-tablet transfer has no limit, so it takes everything. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="notes.db" />
        <include domain="database" path="notes.db-wal" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="notes.db" />
        <include domain="database" path="notes.db-wal" />
        <include domain="file" path="images/" />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
